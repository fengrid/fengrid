# Keep the docker build context small and deterministic: the linux Dockerfiles
# only need build/, qt/, fonts/ (see the COPY lines). Everything else is host
# tooling, runtime state, or generated byproduct — shipping it wastes transfer
# time and lets stale artifacts (qt/dist tarballs, checked-in *.spec) enter
# the image.
.git
**/__pycache__
**/*.egg-info
**/*.pyc
*.log
*.tmp
.cache/
.DS_Store
Thumbs.db

# build byproducts
qt/.venv
qt/build
qt/dist
qt/.pytest_cache
*.spec

# generated runtime state (root of repo)
list.txt
list.js
meta.js
meta-state.tsv
server-state.js
fonts-list.txt
font-meta.js

# internal-only trees and legacy frontends
branding
docs
icons
server
macos
.github
*.html
install.sh
install.ps1
update.sh

# never ship stale artifacts into a fresh build
*.tar.gz
*.zip
