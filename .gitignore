# internal candidate branding docs — not for distribution
# (root-anchored: the runtime mark ships from the tracked
#  qt/resources/branding/, which must NOT be caught by this rule)
/branding/

# Dev-only symlink to system icons (root-anchored: the vendored
# Qlementine set under qt/resources/icons/ must stay tracked — #112)
/icons

# Internal design brief — not for distribution
IDEA.md

# Scratch / cache / editor & OS junk
*.log
*.tmp
.cache/
.DS_Store
Thumbs.db

# python bytecode caches
__pycache__/
*.pyc

# build-provenance stamp written by the build scripts (#43)
/qt/.build-commit

# local build outputs — build/scripts/build-docker-linux.sh lands artifacts in
# build/<target>/; build/pyinstaller/ holds regenerated spec files (never
# commit host-absolute specs). build/scripts stays tracked; dependency
# manifests live in the uv project (qt/pyproject.toml + qt/uv.lock).
build/*
!build/scripts/
dist/
qt/dist/
qt/build/

# pytest cache
.pytest_cache/
list.txt
meta-state.tsv.new
working.md~
