# Generated at install time — regenerate with install.sh
list.txt
list.js
meta.js
meta-state.tsv

# internal candidate branding docs — not for distribution
# (root-anchored: the runtime mark ships from the tracked
#  qt/resources/branding/, which must NOT be caught by this rule)
/branding/

# Dev-only symlink to system icons
icons

# Internal design brief — not for distribution
IDEA.md

# Scratch / cache / editor & OS junk
*.log
*.tmp
.cache/
.DS_Store
Thumbs.db

# python bytecode caches
__pycache__/
*.pyc

# local build outputs — build/scripts/build-docker-linux.sh lands artifacts in
# build/<target>/; build/pyinstaller/ holds regenerated spec files (never
# commit host-absolute specs). build/scripts + requirements stay tracked.
build/*
!build/scripts/
!build/requirements-*.txt
dist/

# pytest cache
.pytest_cache/

# runtime state written by server/serve.py at startup (removed at shutdown)
server-state.js
fonts-list.txt
font-meta.js
